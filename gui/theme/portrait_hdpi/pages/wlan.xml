<?xml version="1.0"?>
<recovery>
	<pages>

		<!-- Main WLAN page -->
		<page name="wlan">
			<action>
				<action function="set">tw_back=advanced</action>
				<action function="set">wlanlistdisplay=0</action>
				<action function="wlan_info"/>
			</action>

			<!-- If scan results exist, show them on this page -->
			<action>
				<condition var1="fileexists" var2="/tmp/wlan/list.txt"/>
				<action function="set">wlanlistdisplay=1</action>
				<action function="set">of_file_to_read=/tmp/wlan/list.txt</action>
			</action>

			<action>
				<condition var1="fileexists" op="!=" var2="/tmp/wlan/list.txt"/>
				<action function="set">of_file_to_read=</action>
			</action>

			<!-- WLAN enabled card -->
			<image>
				<condition var1="tw_wlan_enabled" var2="1"/>
				<placement x="40" y="%ab_h%"/>
				<image resource="main_switch_card_active"/>
			</image>

			<image style="switch_on">
				<condition var1="tw_wlan_enabled" var2="1"/>
				<placement x="%main_switch_icon_x%" y="%ab2_y%" placement="4"/>
			</image>

			<text style="text_ab_switch_on">
				<condition var1="tw_wlan_enabled" var2="1"/>
				<placement x="%switch_text_x%" y="%ab_bc2_y%"/>
				<text>WLAN</text>
			</text>

			<button style="bs_btn">
				<condition var1="tw_wlan_enabled" var2="1"/>
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%ab_btn_h%"/>
				<action function="wlan_disable"/>
				<action function="set">of_file_to_read=</action>
				<action function="set">wlanlistdisplay=0</action>
				<action function="set">wlanselectedid=</action>
				<action function="set">wlanempty=</action>
				<action function="set">wlan_connected_name=</action>
				<action function="set">wlan_connect_text=</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="set">wlan_refreshing=0</action>
				<action function="set">wlan_info_connected=0</action>
				<action function="set">wlan_info_text=</action>
				<action function="set">wlan_info_ssid=</action>
				<action function="set">wlan_info_ip=</action>
				<action function="page">wlan</action>
			</button>

			<!-- WLAN disabled card -->
			<image>
				<condition var1="tw_wlan_enabled" op="!=" var2="1"/>
				<placement x="40" y="%ab_h%"/>
				<image resource="main_switch_card_not_active"/>
			</image>

			<image style="switch_off">
				<condition var1="tw_wlan_enabled" op="!=" var2="1"/>
				<placement x="%main_switch_icon_x%" y="%ab2_y%" placement="4"/>
			</image>

			<text style="text_ab_switch_off">
				<condition var1="tw_wlan_enabled" op="!=" var2="1"/>
				<placement x="%gl_text_x%" y="%ab_bc2_y%"/>
				<text>WLAN</text>
			</text>

			<button style="bs_btn">
				<condition var1="tw_wlan_enabled" op="!=" var2="1"/>
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%ab_btn_h%"/>
				<action function="set">wlan_connect_done=0</action>
				<action function="wlan_enable"/>
				<action function="wlan_info"/>
				<action function="page">wlan</action>
			</button>

			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>{@wlan_menu}</text>
			</text>

			<button style="actionbar">
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<action function="set">general_back=wlan</action>
				<action function="page">wlan_settings</action>
			</button>

			<image>
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<image resource="actionbar_settings"/>
			</image>

			<!-- Available networks -->
			<text style="caption">
				<condition var1="tw_wlan_enabled" var2="1"/>
				<placement x="%gl_text_x%" y="552+%cutout_w%"/>
				<text>{@wlan_list}</text>
			</text>

			<!-- WLAN scan/refresh button. The visible reset icon spins while scanning. -->
			<button style="actionbar">
				<condition var1="tw_wlan_enabled" var2="1"/>
				<placement x="%ab_btn1_x%" y="%row2_1a_y%" w="96" h="112" placement="4"/>
				<action function="set">wlan_refreshing=1</action>
				<action function="page">wlan_refresh</action>
			</button>

			<!-- Normal refresh icon -->
			<image>
				<condition var1="tw_wlan_enabled" var2="1"/>
				<condition var1="wlan_refreshing" op="!=" var2="1"/>
				<placement x="%ab_btn1_x%" y="%row2_1a_y%" placement="4"/>
				<image resource="actionbar_reset"/>
			</image>

			<!-- Spinning refresh icon while scanning -->
			<object type="spinningimage">
				<condition var1="tw_wlan_enabled" var2="1"/>
				<condition var1="wlan_refreshing" var2="1"/>
				<placement x="%ab_btn1_x%" y="%row2_1a_y%" placement="4"/>
				<offset x="0" y="0"/>
				<image resource="actionbar_reset"/>
				<speed render="2"/>
				<rotate speed="640" clockwise="0" start="0"/>
			</object>

			<text style="text_body2_hl">
				<condition var1="tw_wlan_enabled" var2="1"/>
				<condition var1="fileexists" op="!=" var2="/tmp/wlan/list.txt"/>
				<placement x="%gl_text_x%" y="%row2_2a_y%"/>
				<text>{@wlan_empty}</text>
			</text>

			<!-- Full WLAN scan list.
			     Per-row icon is handled in gui/listbox.cpp:
			     selected=wlan_saved for saved SSIDs, unselected=wlan for normal SSIDs. -->
			<listbox style="group_list">
				<condition var1="tw_wlan_enabled" var2="1"/>
				<condition var1="fileexists" var2="/tmp/wlan/list.txt"/>
				<placement x="0" y="%row2_2a_y%" w="%screen_w%" h="%bl_h5%"/>
				<icon selected="wlan_saved" unselected="wlan" locked="wlan_locked"/>
				<data name="of_file_to_read"/>
			</listbox>

			<!-- Connected WLAN info under the network list -->
			<text style="text_body2_hl">
				<condition var1="tw_wlan_enabled" var2="1"/>
				<condition var1="wlan_info_connected" var2="1"/>
				<placement x="%gl_text_x%" y="%row7_1a_y%"/>
				<text>%wlan_info_text%</text>
			</text>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="set">wlanlistdisplay=</action>
				<action function="set">of_file_to_read=</action>
				<action function="set">wlan_refreshing=0</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="set">wlanlistdisplay=</action>
				<action function="set">of_file_to_read=</action>
				<action function="set">wlan_refreshing=0</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="page">advanced</action>
			</action>
		</page>

		<!-- WLAN settings page -->
		<page name="wlan_settings">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>WLAN Settings</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>Options</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%row2_2a_y%" w="%screen_w%" h="%bl_h4%"/>

				<listitem name="Saved networks">
					<icon res="wlan_saved"/>
					<action function="page">wlan_saved</action>
				</listitem>

				<listitem name="Test Network Connection">
					<icon res="wlan"/>
					<action function="page">wlan_settings</action>
					<action function="overlay">console</action>
					<action function="terminalcommand">
echo "Trying test net connection with ping bing.com ..."
echo "=============Ping bing.com==========="
echo " "
busybox ping -w 4 bing.com
echo " "
echo "====================================="
echo " "
echo " "
echo " "
					</action>
				</listitem>

				<listitem name="Remote Web Access">
					<icon res="rwa"/>
					<action function="page">remote_web_access_settings</action>
				</listitem>

				<listitem name="Network Storage (NAS)">
					<icon res="smb_share"/>
					<action function="page">nas_settings</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">wlan</action>
			</action>
		</page>

		<!-- NAS / Network Storage settings page -->
		<page name="nas_settings">
			<action>
				<action function="nas_info"/>
			</action>

			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Network Storage</text>
			</text>

			<image>
				<condition var1="tw_nas_mounted" var2="1"/>
				<placement x="40" y="%ab_h%"/>
				<image resource="main_switch_card_active"/>
			</image>

			<text style="text_ab_switch_on">
				<condition var1="tw_nas_mounted" var2="1"/>
				<placement x="%switch_text_x%" y="%ab_bc2_y%"/>
				<text>NAS mounted</text>
			</text>

			<image>
				<condition var1="tw_nas_mounted" op="!=" var2="1"/>
				<placement x="40" y="%ab_h%"/>
				<image resource="main_switch_card_not_active"/>
			</image>

			<text style="text_ab_switch_off">
				<condition var1="tw_nas_mounted" op="!=" var2="1"/>
				<placement x="%switch_text_x%" y="%ab_bc2_y%"/>
				<text>NAS not mounted</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_2_y%"/>
				<text>Status</text>
			</text>

			<text style="text_body2_hl">
				<placement x="%gl_text_x%" y="%row2_3a_y%"/>
				<text>%tw_nas_status_text%</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row3_1a_y%"/>
				<text>Connection</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%row3_2a_y%" w="%screen_w%" h="%bl_h6%"/>
				<data requireReload="1"/>

				<listitem name="Type: %tw_nas_type%">
					<icon res="smb_share"/>
					<action function="page">nas_type_select</action>
				</listitem>

				<listitem name="Host / IP: %tw_nas_host%">
					<icon res="wlan"/>
					<action function="page">nas_edit_host</action>
				</listitem>

				<listitem name="Username: %tw_nas_user%">
					<icon res="wlan_saved"/>
					<action function="page">nas_edit_user</action>
				</listitem>

				<listitem name="Password: ***">
					<condition var1="tw_nas_pass" op="!=" var2=""/>
					<icon res="wlan_locked"/>
					<action function="page">nas_edit_pass</action>
				</listitem>

				<listitem name="Password">
					<condition var1="tw_nas_pass" var2=""/>
					<icon res="wlan_locked"/>
					<action function="page">nas_edit_pass</action>
				</listitem>

				<listitem name="Share: %tw_nas_share%">
					<icon res="smb_share"/>
					<action function="page">nas_edit_share</action>
				</listitem>

				<listitem name="Path: %tw_nas_path%">
					<icon res="rwa"/>
					<action function="page">nas_edit_path</action>
				</listitem>

				<listitem name="Domain: %tw_nas_domain%">
					<icon res="smb_share"/>
					<action function="page">nas_edit_domain</action>
				</listitem>

				<listitem name="Port: %tw_nas_port%">
					<icon res="wlan"/>
					<action function="page">nas_edit_port</action>
				</listitem>
			</listbox>

			<button style="btn_raised_hl">
				<condition var1="tw_nas_mounted" op="!=" var2="1"/>
				<placement x="%btn_raised_left_x%" y="%row_btn2_y%"/>
				<text>Mount + Use</text>
				<action function="nas_mount"/>
				<action function="nas_select"/>
				<action function="page">nas_settings</action>
			</button>

			<button style="btn_raised_hl">
				<condition var1="tw_nas_mounted" var2="1"/>
				<placement x="%btn_raised_left_x%" y="%row_btn2_y%"/>
				<text>Use NAS</text>
				<action function="nas_select"/>
				<action function="page">nas_settings</action>
			</button>

			<button style="btn_raised">
				<condition var1="tw_nas_mounted" var2="1"/>
				<placement x="%btn_raised_right_x%" y="%row_btn2_y%" placement="1"/>
				<text>Unmount</text>
				<action function="nas_unmount"/>
				<action function="page">nas_settings</action>
			</button>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">wlan_settings</action>
			</action>
		</page>

		<!-- NAS type selector -->
		<page name="nas_type_select">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Select NAS Type</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>Current type</text>
			</text>

			<text style="text_body2_hl">
				<placement x="%gl_text_x%" y="%row2_2a_y%"/>
				<text>%tw_nas_type%</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row3_1a_y%"/>
				<text>Connection type</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%row3_2a_y%" w="%screen_w%" h="%bl_h2%"/>

				<listitem name="SFTP">
					<icon res="wlan_locked"/>
					<action function="set">tw_nas_type=sftp</action>
					<action function="set">tw_nas_port=22</action>
					<action function="page">nas_settings</action>
				</listitem>

				<listitem name="SMB">
					<icon res="smb_share"/>
					<action function="set">tw_nas_type=smb</action>
					<action function="page">nas_settings</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="back"/>
				<action function="page">nas_settings</action>
			</action>
		</page>

		<!-- NAS edit: Host / IP -->
		<page name="nas_edit_host">
			<template name="dialog_body"/>
			<template name="keyboardtemplate"/>

			<button>
				<placement x="%bg_storage_x%" y="%bg_storage_y%"/>
				<image resource="dialog_bg"/>
			</button>

			<text style="text_dlg_title">
				<placement x="%bg_storage_hdr_x%" y="%bg_storage_hdr_y%"/>
				<text>Host / IP</text>
			</text>

			<input>
				<placement x="%bg_storage_hdr_x%" y="%db_text3_y%" w="700" h="%input_height%"/>
				<data name="tw_nas_host"/>
				<restrict maxlen="128"/>
				<action function="page">nas_settings</action>
			</input>

			<button style="btn_dlg">
				<placement x="%db_left_x%" y="%db_y%"/>
				<text>{@cancel_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<button style="btn_dlg_hl">
				<placement x="%db_right_x%" y="%db_y%"/>
				<text>{@ok_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<action>
				<touch key="back"/>
				<action function="page">nas_settings</action>
			</action>
		</page>

		<!-- NAS edit: Username -->
		<page name="nas_edit_user">
			<template name="dialog_body"/>
			<template name="keyboardtemplate"/>

			<button>
				<placement x="%bg_storage_x%" y="%bg_storage_y%"/>
				<image resource="dialog_bg"/>
			</button>

			<text style="text_dlg_title">
				<placement x="%bg_storage_hdr_x%" y="%bg_storage_hdr_y%"/>
				<text>Username</text>
			</text>

			<input>
				<placement x="%bg_storage_hdr_x%" y="%db_text3_y%" w="700" h="%input_height%"/>
				<data name="tw_nas_user"/>
				<restrict maxlen="128"/>
				<action function="page">nas_settings</action>
			</input>

			<button style="btn_dlg">
				<placement x="%db_left_x%" y="%db_y%"/>
				<text>{@cancel_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<button style="btn_dlg_hl">
				<placement x="%db_right_x%" y="%db_y%"/>
				<text>{@ok_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<action>
				<touch key="back"/>
				<action function="page">nas_settings</action>
			</action>
		</page>

		<!-- NAS edit: Password -->
		<page name="nas_edit_pass">
			<action function="set">of_show_pass=1</action>

			<template name="dialog_body"/>
			<template name="keyboardtemplate"/>

			<button>
				<placement x="%bg_storage_x%" y="%bg_storage_y%"/>
				<image resource="dialog_bg"/>
			</button>

			<text style="text_dlg_title">
				<placement x="%bg_storage_hdr_x%" y="%bg_storage_hdr_y%"/>
				<text>Password</text>
			</text>

			<input>
				<placement x="%bg_storage_hdr_x%" y="%db_text3_y%" w="700" h="%input_height%"/>
				<data name="tw_nas_pass" mask="*" maskvariable="pass_enter_mask"/>
				<restrict maxlen="254"/>
				<action function="page">nas_settings</action>
			</input>

			<button style="btn_dlg">
				<placement x="%db_left_x%" y="%db_y%"/>
				<text>{@cancel_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<button style="btn_dlg_hl">
				<placement x="%db_right_x%" y="%db_y%"/>
				<text>{@ok_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<action>
				<touch key="back"/>
				<action function="page">nas_settings</action>
			</action>
		</page>

		<!-- NAS edit: SMB share -->
		<page name="nas_edit_share">
			<template name="dialog_body"/>
			<template name="keyboardtemplate"/>

			<button>
				<placement x="%bg_storage_x%" y="%bg_storage_y%"/>
				<image resource="dialog_bg"/>
			</button>

			<text style="text_dlg_title">
				<placement x="%bg_storage_hdr_x%" y="%bg_storage_hdr_y%"/>
				<text>SMB Share Name</text>
			</text>

			<input>
				<placement x="%bg_storage_hdr_x%" y="%db_text3_y%" w="700" h="%input_height%"/>
				<data name="tw_nas_share"/>
				<restrict maxlen="128"/>
				<action function="page">nas_settings</action>
			</input>

			<button style="btn_dlg">
				<placement x="%db_left_x%" y="%db_y%"/>
				<text>{@cancel_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<button style="btn_dlg_hl">
				<placement x="%db_right_x%" y="%db_y%"/>
				<text>{@ok_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<action>
				<touch key="back"/>
				<action function="page">nas_settings</action>
			</action>
		</page>

		<!-- NAS edit: remote path -->
		<page name="nas_edit_path">
			<template name="dialog_body"/>
			<template name="keyboardtemplate"/>

			<button>
				<placement x="%bg_storage_x%" y="%bg_storage_y%"/>
				<image resource="dialog_bg"/>
			</button>

			<text style="text_dlg_title">
				<placement x="%bg_storage_hdr_x%" y="%bg_storage_hdr_y%"/>
				<text>Remote Folder / Path</text>
			</text>

			<input>
				<placement x="%bg_storage_hdr_x%" y="%db_text3_y%" w="700" h="%input_height%"/>
				<data name="tw_nas_path"/>
				<restrict maxlen="256"/>
				<action function="page">nas_settings</action>
			</input>

			<button style="btn_dlg">
				<placement x="%db_left_x%" y="%db_y%"/>
				<text>{@cancel_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<button style="btn_dlg_hl">
				<placement x="%db_right_x%" y="%db_y%"/>
				<text>{@ok_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<action>
				<touch key="back"/>
				<action function="page">nas_settings</action>
			</action>
		</page>

		<!-- NAS edit: domain/workgroup -->
		<page name="nas_edit_domain">
			<template name="dialog_body"/>
			<template name="keyboardtemplate"/>

			<button>
				<placement x="%bg_storage_x%" y="%bg_storage_y%"/>
				<image resource="dialog_bg"/>
			</button>

			<text style="text_dlg_title">
				<placement x="%bg_storage_hdr_x%" y="%bg_storage_hdr_y%"/>
				<text>SMB Domain / Workgroup</text>
			</text>

			<input>
				<placement x="%bg_storage_hdr_x%" y="%db_text3_y%" w="700" h="%input_height%"/>
				<data name="tw_nas_domain"/>
				<restrict maxlen="128"/>
				<action function="page">nas_settings</action>
			</input>

			<button style="btn_dlg">
				<placement x="%db_left_x%" y="%db_y%"/>
				<text>{@cancel_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<button style="btn_dlg_hl">
				<placement x="%db_right_x%" y="%db_y%"/>
				<text>{@ok_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<action>
				<touch key="back"/>
				<action function="page">nas_settings</action>
			</action>
		</page>

		<!-- NAS edit: SFTP port -->
		<page name="nas_edit_port">
			<template name="dialog_body"/>
			<template name="keyboardtemplate"/>

			<button>
				<placement x="%bg_storage_x%" y="%bg_storage_y%"/>
				<image resource="dialog_bg"/>
			</button>

			<text style="text_dlg_title">
				<placement x="%bg_storage_hdr_x%" y="%bg_storage_hdr_y%"/>
				<text>SFTP Port</text>
			</text>

			<input>
				<placement x="%bg_storage_hdr_x%" y="%db_text3_y%" w="700" h="%input_height%"/>
				<data name="tw_nas_port"/>
				<restrict minlen="1" maxlen="5"/>
				<action function="page">nas_settings</action>
			</input>

			<button style="btn_dlg">
				<placement x="%db_left_x%" y="%db_y%"/>
				<text>{@cancel_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<button style="btn_dlg_hl">
				<placement x="%db_right_x%" y="%db_y%"/>
				<text>{@ok_btn}</text>
				<action function="page">nas_settings</action>
			</button>

			<action>
				<touch key="back"/>
				<action function="page">nas_settings</action>
			</action>
		</page>

		<!-- Remote Web Access settings page -->
		<page name="remote_web_access_settings">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Remote Web Access</text>
			</text>

			<image>
				<condition var1="of_remote_web_access_enabled" var2="1"/>
				<placement x="40" y="%ab_h%"/>
				<image resource="main_switch_card_active"/>
			</image>

			<image style="switch_on">
				<condition var1="of_remote_web_access_enabled" var2="1"/>
				<placement x="%main_switch_icon_x%" y="%ab2_y%" placement="4"/>
			</image>

			<text style="text_ab_switch_on">
				<condition var1="of_remote_web_access_enabled" var2="1"/>
				<placement x="%switch_text_x%" y="%ab_bc2_y%"/>
				<text>Enable Remote Web Access</text>
			</text>

			<button style="bs_btn">
				<condition var1="of_remote_web_access_enabled" var2="1"/>
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%ab_btn_h%"/>
				<action function="set">of_remote_web_access_enabled=0</action>
				<action function="terminalcommand">stop microhttpd</action>
				<action function="page">remote_web_access_settings</action>
			</button>

			<image>
				<condition var1="of_remote_web_access_enabled" op="!=" var2="1"/>
				<placement x="40" y="%ab_h%"/>
				<image resource="main_switch_card_not_active"/>
			</image>

			<image style="switch_off">
				<condition var1="of_remote_web_access_enabled" op="!=" var2="1"/>
				<placement x="%main_switch_icon_x%" y="%ab2_y%" placement="4"/>
			</image>

			<text style="text_ab_switch_off">
				<condition var1="of_remote_web_access_enabled" op="!=" var2="1"/>
				<placement x="%gl_text_x%" y="%ab_bc2_y%"/>
				<text>Enable Remote Web Access</text>
			</text>

			<button style="bs_btn">
				<condition var1="of_remote_web_access_enabled" op="!=" var2="1"/>
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%ab_btn_h%"/>
				<action function="set">of_remote_web_access_enabled=1</action>
				<action function="terminalcommand">start microhttpd</action>
				<action function="page">remote_web_access_settings</action>
			</button>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>Options</text>
			</text>

			<text style="text_body2_hl">
				<placement x="%gl_text_x%" y="%row2_2a_y%"/>
				<text>Empty for now</text>
			</text>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">wlan_settings</action>
			</action>
		</page>

		<!-- Selected network connect flow -->
		<page name="wlan_connect">
			<action>
				<action function="set">wlan_password=</action>
				<action function="set">of_show_pass=1</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="setvaluebyfile">wlanencryption,/tmp/wlan/list/%wlanselectedid%</action>
				<action function="page">wlan_connect_decide</action>
			</action>
		</page>

		<!-- Decide whether to connect directly or show password popup -->
		<page name="wlan_connect_decide">
			<action>
				<condition var1="wlanencryption" op="!=" var2="OPEN"/>
				<action function="overlay">wlan_password</action>
				<action function="page">wlan</action>
			</action>

			<action>
				<condition var1="wlanencryption" var2="OPEN"/>
				<action function="page">wlan</action>
				<action function="set">wlan_connect_text=Connecting</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="overlay">wlan_connecting</action>
				<action function="wlan_connect"/>
				<action function="wlan_saved_refresh"/>
				<action function="wlan_info"/>
				<action function="overlay"/>
				<action function="page">wlan</action>
			</action>
		</page>

		<!-- Saved network auto-connect flow -->
		<page name="wlan_connect_saved">
			<action>
				<action function="page">wlan</action>
				<action function="set">wlan_connect_text=Connecting</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="overlay">wlan_connecting</action>
				<action function="wlan_connect_saved"/>
				<action function="wlan_saved_refresh"/>
				<action function="wlan_info"/>
				<action function="overlay"/>
				<action function="page">wlan</action>
			</action>
		</page>

		<!-- WLAN refresh flow: keeps WLAN page visible and spins the refresh icon -->
		<page name="wlan_refresh">
			<action>
				<action function="page">wlan</action>
				<action function="set">of_file_to_read=</action>
				<action function="set">wlanlistdisplay=0</action>
				<action function="wlan_scan"/>
				<action function="wlan_saved_refresh"/>
				<action function="wlan_info"/>
				<action function="set">wlan_refreshing=0</action>
				<action function="page">wlan</action>
			</action>
		</page>

		<!-- Password popup overlay -->
		<page name="wlan_password">
			<action function="set">of_show_pass=1</action>

			<template name="dialog_body"/>
			<template name="keyboardtemplate"/>

			<button>
				<placement x="%bg_storage_x%" y="%bg_storage_y%"/>
				<image resource="dialog_bg"/>
			</button>

			<text style="text_dlg_title">
				<placement x="%bg_storage_hdr_x%" y="%bg_storage_hdr_y%"/>
				<text>%wlanselectedid%</text>
			</text>

			<text style="text_body1">
				<placement x="%bg_storage_hdr_x%" y="%db_text1_y%"/>
				<text>{@wlan_encryption} %wlanencryption%</text>
			</text>

			<text style="text_body1">
				<placement x="%bg_storage_hdr_x%" y="%db_text2_y%"/>
				<text>{@decrypt_data_enter_pass}</text>
			</text>

			<input>
				<placement x="%bg_storage_hdr_x%" y="%db_text3_y%" w="700" h="%input_height%"/>
				<data name="wlan_password" mask="*" maskvariable="pass_enter_mask"/>
				<restrict minlen="8" maxlen="254"/>
				<action function="overlay"/>
				<action function="page">wlan</action>
				<action function="set">wlan_connect_text=Connecting</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="overlay">wlan_connecting</action>
				<action function="wlan_connect"/>
				<action function="wlan_saved_refresh"/>
				<action function="wlan_info"/>
				<action function="overlay"/>
				<action function="page">wlan</action>
			</input>

			<button style="btn_dlg">
				<placement x="%db_left_x%" y="%db_y%"/>
				<text>{@cancel_btn}</text>
				<actions>
					<action function="set">wlan_password=</action>
					<action function="set">wlan_connect_done=0</action>
					<action function="overlay"/>
				</actions>
			</button>

			<button style="btn_dlg_hl">
				<placement x="%db_right_x%" y="%db_y%"/>
				<text>{@ok_btn}</text>
				<actions>
					<action function="overlay"/>
					<action function="page">wlan</action>
					<action function="set">wlan_connect_text=Connecting</action>
					<action function="set">wlan_connect_done=0</action>
					<action function="overlay">wlan_connecting</action>
					<action function="wlan_connect"/>
					<action function="wlan_saved_refresh"/>
					<action function="wlan_info"/>
					<action function="overlay"/>
					<action function="page">wlan</action>
				</actions>
			</button>

			<action>
				<touch key="back"/>
				<action function="set">wlan_password=</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="overlay"/>
			</action>
		</page>

		<!-- WLAN connecting popup overlay -->
		<page name="wlan_connecting">
			<template name="dialog_body"/>

			<button>
				<placement x="%bg_storage_x%" y="%bg_storage_y%"/>
				<image resource="dialog_bg"/>
			</button>

			<text style="text_dlg_title">
				<placement x="%bg_storage_hdr_x%" y="%bg_storage_hdr_y%"/>
				<text>%wlanselectedid%</text>
			</text>

			<!-- Spinning icon while connecting / getting IP -->
			<object type="spinningimage">
				<condition var1="wlan_connect_done" op="!=" var2="1"/>
				<placement x="%center_x%" y="%db_text2_y%" placement="5"/>
				<offset x="40" y="0"/>
				<image resource="wlan_loading"/>
				<speed render="2"/>
				<rotate speed="640" clockwise="1" start="0"/>
			</object>

			<!-- Check icon after connected -->
			<image>
				<condition var1="wlan_connect_done" var2="1"/>
				<placement x="%wlan_connect_icon_x%" y="%db_text2_y%" placement="5"/>
				<image resource="check"/>
			</image>

			<text style="text_body1">
				<placement x="%center_x%" y="%db_text3_y%" placement="5"/>
				<text>%wlan_connect_text%</text>
			</text>

			<action>
				<touch key="back"/>
			</action>
		</page>

		<!-- Saved networks page -->
		<page name="wlan_saved">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Saved networks</text>
			</text>

			<action function="set">wlanlistdisplay=0</action>
			<action function="set">wlansaveddisplay=0</action>
			<action function="wlan_saved_refresh"/>

			<action>
				<condition var1="fileexists" var2="/tmp/wlan/saved.txt"/>
				<action function="set">wlansaveddisplay=1</action>
				<action function="set">of_file_to_read=/tmp/wlan/saved.txt</action>
			</action>

			<action>
				<condition var1="fileexists" op="!=" var2="/tmp/wlan/saved.txt"/>
				<action function="set">of_file_to_read=</action>
			</action>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>Saved Wi-Fi networks</text>
			</text>

			<text style="text_body2_hl">
				<condition var1="fileexists" op="!=" var2="/tmp/wlan/saved.txt"/>
				<placement x="%gl_text_x%" y="%row2_2a_y%"/>
				<text>No saved networks found</text>
			</text>

			<listbox style="group_list">
				<condition var1="fileexists" var2="/tmp/wlan/saved.txt"/>
				<placement x="0" y="%row2_2a_y%" w="%screen_w%" h="%bl_h4%"/>
				<icon selected="wlan_saved" unselected="wlan_saved" delete="delete"/>
				<data name="of_file_to_read"/>
			</listbox>

			<button style="btn_flat_qw">
				<placement x="%btn_raised_left_x%" y="%row7_1a_y%"/>
				<text>Refresh</text>
				<action function="page">wlan_saved</action>
			</button>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="set">of_file_to_read=</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="set">of_file_to_read=</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="page">wlan_settings</action>
			</action>
		</page>

		<!-- WLAN forget saved network flow -->
		<page name="wlan_forget_saved">
			<action>
				<action function="wlan_forget_saved"/>
				<action function="page">wlan_saved</action>
			</action>
		</page>

	</pages>
</recovery>
