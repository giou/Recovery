<?xml version="1.0"?>
<recovery>
	<pages>

		<!-- Main WiFi page: Connection / Apps tabs -->
		<page name="wlan">
			<action>
				<action function="set">tw_back=advanced</action>
				<action function="set">wlanlistdisplay=0</action>
				<action function="wlan_info"/>
			</action>

			<!-- If scan results exist, show them on this page -->
			<action>
				<condition var1="fileexists" var2="/tmp/wlan/list.txt"/>
				<action function="set">wlanlistdisplay=1</action>
				<action function="set">of_file_to_read=/tmp/wlan/list.txt</action>
			</action>

			<action>
				<condition var1="fileexists" op="!=" var2="/tmp/wlan/list.txt"/>
				<action function="set">of_file_to_read=</action>
			</action>

			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>{@wlan_menu}</text>
			</text>

			<!-- Settings (gear) -->
			<button style="actionbar">
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<action function="set">general_back=wlan</action>
				<action function="page">wlan_settings</action>
			</button>

			<image>
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<image resource="actionbar_settings"/>
			</image>

			<!-- ===== Tabs (Connection active) ===== -->
			<button style="tab_btn_hl">
				<placement x="156" y="%tab_btn_y%" w="360" h="84"/>
				<text>Connection</text>
			</button>

			<button style="tab_btn">
				<placement x="564" y="%tab_btn_y%" w="360" h="84"/>
				<text>Apps</text>
				<action function="page">wlan_apps</action>
			</button>

			<image style="tab">
				<placement x="180" y="%tab_title_h%" placement="2"/>
			</image>

				<!-- WiFi enabled card -->
				<image>
					<condition var1="tw_wlan_enabled" var2="1"/>
					<placement x="40" y="%wifi_card_y%"/>
					<image resource="main_switch_card_active"/>
				</image>

				<image style="switch_on">
					<condition var1="tw_wlan_enabled" var2="1"/>
					<condition var1="wlan_state" op="!=" var2="disabling"/>
					<placement x="%main_switch_icon_x%" y="%wifi_switch_icon_y%" placement="4"/>
				</image>

				<object type="spinningimage">
					<condition var1="tw_wlan_enabled" var2="1"/>
					<condition var1="wlan_state" var2="disabling"/>
					<placement x="%main_switch_icon_x%" y="%wifi_switch_icon_y%" placement="4"/>
					<image resource="wlan_loading"/>
					<speed render="2"/>
					<rotate speed="640" clockwise="1" start="0"/>
				</object>

				<text style="text_ab_switch_on">
					<condition var1="tw_wlan_enabled" var2="1"/>
					<placement x="%switch_text_x%" y="%wifi_switch_text_y%"/>
					<text>WiFi</text>
				</text>

				<button style="bs_btn">
					<condition var1="tw_wlan_enabled" var2="1"/>
					<condition var1="wlan_state" op="!=" var2="disabling"/>
					<placement x="0" y="%wifi_card_y%" w="%screen_w%" h="%ab_btn_h%"/>
					<action function="wlan_disable"/>
					<action function="set">of_file_to_read=</action>
					<action function="set">wlanlistdisplay=0</action>
					<action function="set">wlanselectedid=</action>
					<action function="set">wlanempty=</action>
					<action function="set">wlan_connected_name=</action>
					<action function="set">wlan_connect_text=</action>
					<action function="set">wlan_connect_done=0</action>
					<action function="set">wlan_refreshing=0</action>
					<action function="set">wlan_info_connected=0</action>
					<action function="set">wlan_info_text=</action>
					<action function="set">wlan_info_ssid=</action>
					<action function="set">wlan_info_ip=</action>
					<action function="page">wlan</action>
				</button>

				<!-- WiFi disabled card -->
				<image>
					<condition var1="tw_wlan_enabled" op="!=" var2="1"/>
					<placement x="40" y="%wifi_card_y%"/>
					<image resource="main_switch_card_not_active"/>
				</image>

				<image style="switch_off">
					<condition var1="tw_wlan_enabled" op="!=" var2="1"/>
					<condition var1="wlan_state" op="!=" var2="enabling"/>
					<placement x="%main_switch_icon_x%" y="%wifi_switch_icon_y%" placement="4"/>
				</image>

				<object type="spinningimage">
					<condition var1="tw_wlan_enabled" op="!=" var2="1"/>
					<condition var1="wlan_state" var2="enabling"/>
					<placement x="%main_switch_icon_x%" y="%wifi_switch_icon_y%" placement="4"/>
					<image resource="wlan_loading"/>
					<speed render="2"/>
					<rotate speed="640" clockwise="1" start="0"/>
				</object>

				<text style="text_ab_switch_off">
					<condition var1="tw_wlan_enabled" op="!=" var2="1"/>
					<placement x="%switch_text_x%" y="%wifi_switch_text_y%"/>
					<text>WiFi</text>
				</text>

				<button style="bs_btn">
					<condition var1="tw_wlan_enabled" op="!=" var2="1"/>
					<condition var1="wlan_state" op="!=" var2="enabling"/>
					<placement x="0" y="%wifi_card_y%" w="%screen_w%" h="%ab_btn_h%"/>
					<action function="set">wlan_connect_done=0</action>
					<action function="wlan_enable"/>
					<action function="page">wlan</action>
				</button>

				<!-- Available networks header + actions -->
				<text style="caption">
					<condition var1="tw_wlan_enabled" var2="1"/>
					<placement x="%gl_text_x%" y="%wifi_caption_y%"/>
					<text>{@wlan_list}</text>
				</text>

				<!-- Saved networks shortcut -->
				<button style="actionbar">
					<condition var1="tw_wlan_enabled" var2="1"/>
					<placement x="876" y="%wifi_btn_row_y%" placement="4"/>
					<action function="page">wlan_saved</action>
				</button>
				<image>
					<condition var1="tw_wlan_enabled" var2="1"/>
					<placement x="876" y="%wifi_btn_row_y%" placement="4"/>
					<image resource="wlan_saved"/>
				</image>

				<!-- Scan / refresh (the reset icon spins while scanning) -->
				<button style="actionbar">
					<condition var1="tw_wlan_enabled" var2="1"/>
					<placement x="%ab_btn1_x%" y="%wifi_btn_row_y%" w="96" h="112" placement="4"/>
					<action function="set">wlan_refreshing=1</action>
					<action function="page">wlan_refresh</action>
				</button>

				<image>
					<condition var1="tw_wlan_enabled" var2="1"/>
					<condition var1="wlan_refreshing" op="!=" var2="1"/>
					<placement x="%ab_btn1_x%" y="%wifi_btn_row_y%" placement="4"/>
					<image resource="actionbar_reset"/>
				</image>

				<object type="spinningimage">
					<condition var1="tw_wlan_enabled" var2="1"/>
					<condition var1="wlan_refreshing" var2="1"/>
					<placement x="%ab_btn1_x%" y="%wifi_btn_row_y%" placement="4"/>
					<offset x="0" y="0"/>
					<image resource="actionbar_reset"/>
					<speed render="2"/>
					<rotate speed="640" clockwise="0" start="0"/>
				</object>

				<!-- Full-height network list (scrolls internally). -->
				<listbox style="group_list">
					<condition var1="tw_wlan_enabled" var2="1"/>
					<condition var1="fileexists" var2="/tmp/wlan/list.txt"/>
					<placement x="0" y="%wifi_list_y%" w="%screen_w%" h="%wifi_list_h%"/>
					<icon selected="wlan_saved" unselected="wlan" locked="wlan_locked"/>
					<data name="of_file_to_read"/>
				</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="set">wlanlistdisplay=</action>
				<action function="set">of_file_to_read=</action>
				<action function="set">wlan_refreshing=0</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="set">wlanlistdisplay=</action>
				<action function="set">of_file_to_read=</action>
				<action function="set">wlan_refreshing=0</action>
				<action function="set">wlan_connect_done=0</action>
				<action function="page">advanced</action>
			</action>
		</page>

		<!-- WiFi Apps tab: network apps & services (no toggle here) -->
		<page name="wlan_apps">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>{@wlan_menu}</text>
			</text>

			<!-- Settings (gear) -->
			<button style="actionbar">
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<action function="set">general_back=wlan_apps</action>
				<action function="page">wlan_settings</action>
			</button>

			<image>
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<image resource="actionbar_settings"/>
			</image>

			<!-- ===== Tabs (Apps active) ===== -->
			<button style="tab_btn">
				<placement x="156" y="%tab_btn_y%" w="360" h="84"/>
				<text>Connection</text>
				<action function="page">wlan</action>
			</button>

			<button style="tab_btn_hl">
				<placement x="564" y="%tab_btn_y%" w="360" h="84"/>
				<text>Apps</text>
			</button>

			<image style="tab">
				<placement x="588" y="%tab_title_h%" placement="2"/>
			</image>

			<text style="caption">
				<placement x="%gl_text_x%" y="%tab_title_h%"/>
				<text>Network apps &amp; services</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%wifi_apps_list_y%" w="%screen_w%" h="%wifi_apps_list_h%"/>

				<listitem name="Test Network Connection">
					<icon res="wlan_test"/>
					<action function="set">wlan_test_title=Network Connection</action>
					<action function="set">wlan_test_line1=Testing network connection...</action>
					<action function="set">wlan_test_line2=</action>
					<action function="set">wlan_test_line3=</action>
					<action function="set">wlan_test_line4=</action>
					<action function="set">wlan_test_line5=</action>
					<action function="set">wlan_test_done=0</action>
					<action function="overlay">wlan_test_connection</action>
					<action function="wlan_test_connection"/>
				</listitem>

				<!-- OrangeFox Updates entry hidden: the updater only serves official
				     builds, so on this unofficial tree it is dead UI. Pages kept. -->
				<listitem name="Remote Web Access">
					<icon res="rwa"/>
					<action function="page">remote_web_access_settings</action>
				</listitem>

				<listitem name="Network Storage (NAS)">
					<icon res="smb_share"/>
					<action function="page">nas_settings</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">advanced</action>
			</action>
		</page>

		<!-- WiFi settings page (gear target) -->
		<page name="wlan_settings">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>WiFi Settings</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>Automatic connection</text>
			</text>

			<listbox style="settingslist_group">
				<placement x="0" y="%row2_2a_y%" w="%screen_w%" h="%lb_group_l3%"/>
				<listitem name="Enable WiFi automatically">
					<data variable="of_wlan_auto_enable"/>
				</listitem>
				<listitem name="Connect to last WiFi automatically">
					<data variable="of_wlan_auto_connect"/>
				</listitem>
				<listitem name="Network ADB automatically">
					<data variable="of_adbd_auto"/>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">%general_back%</action>
			</action>
		</page>

		<!-- OrangeFox updater main page -->
		<page name="fox_updates">
			<template name="base"/>

			<action>
				<action function="set">wlanlistdisplay=0</action>
				<action function="set">wlansaveddisplay=0</action>
			</action>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>OrangeFox Updates</text>
			</text>

			<button style="actionbar">
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<action function="page">fox_update_settings</action>
			</button>

			<image>
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<image resource="actionbar_settings"/>
			</image>

			<image>
				<placement x="40" y="%ab_h%"/>
				<image resource="main_switch_card_active"/>
			</image>

			<image>
				<placement x="%main_switch_icon_x%" y="%ab2_y%" placement="4"/>
				<image resource="overview"/>
			</image>

			<text style="text_ab_switch_on">
				<placement x="%switch_text_x%" y="%ab_bc2_y%"/>
				<text>Recovery Updater</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>Status</text>
			</text>

			<text style="text_body2_hl">
				<placement x="%gl_text_x%" y="%row2_2a_y%"/>
				<text>%fox_update_status%</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row3_1a_y%"/>
				<text>Update details</text>
			</text>

			<listbox style="group_list_flat">
				<placement x="0" y="%row3_2a_y%" w="%screen_w%" h="%bl_h6%"/>
				<data requireReload="1"/>
				<listitem name="Device: %fox_update_device_name%">
					<icon res="devices"/>
				</listitem>
				<listitem name="Current: %fox_update_current_version% / %fox_update_current_type%">
					<icon res="check"/>
				</listitem>
				<listitem name="Latest: %fox_update_latest_version% / %fox_update_latest_type%">
					<icon res="overview"/>
					<action function="fox_update_prepare_available"/>
					<action function="page">fox_update_releases</action>
				</listitem>
				<listitem name="Variant: %fox_update_latest_variant%">
					<icon res="category"/>
				</listitem>
				<listitem name="File: %fox_update_latest_filename%">
					<icon res="archive"/>
				</listitem>
				<listitem name="MD5: %fox_update_latest_md5%">
					<icon res="text_snippet"/>
				</listitem>
			</listbox>

			<button style="btn_raised_hl">
				<placement x="%btn_raised_left_x%" y="%row_btn_y%"/>
				<text>Check</text>
				<action function="fox_update_check"/>
				<action function="page">fox_update_after_check</action>
			</button>

			<button style="btn_raised">
				<placement x="%btn_raised_right_x%" y="%row_btn_y%" placement="1"/>
				<text>Changelog</text>
				<action function="set">wlanlistdisplay=0</action>
				<action function="set">wlansaveddisplay=0</action>
				<action function="set">of_file_to_read=</action>
				<action function="set">of_file_to_read=/tmp/fox_update/changelog.txt</action>
				<action function="page">fox_update_changelog</action>
			</button>

			<button style="btn_raised">
				<condition var1="fox_update_available" var2="1"/>
				<condition var1="fox_update_downloaded" op="!=" var2="1"/>
				<placement x="%btn_raised_left_x%" y="%row_btn1_y%"/>
				<text>Download</text>
				<action function="fox_update_download"/>
				<action function="page">fox_updates</action>
			</button>

			<button style="btn_raised_hl">
				<condition var1="fox_update_downloaded" var2="1"/>
				<placement x="%btn_raised_left_x%" y="%row_btn1_y%"/>
				<text>Install</text>
				<action function="fox_update_install"/>
				<action function="page">fox_update_queue_zip</action>
			</button>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="set">of_file_to_read=</action>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="set">of_file_to_read=</action>
				<action function="page">wlan_apps</action>
			</action>
		</page>

		<!-- OrangeFox updater settings -->
		<page name="fox_update_settings">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Updater Settings</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>Update channel</text>
			</text>

			<listbox style="settingslist_group">
				<placement x="0" y="%row2_2a_y%" w="%screen_w%" h="%lb_group_l1%"/>
				<listitem name="Receive beta updates">
					<data variable="fox_update_allow_beta"/>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">fox_updates</action>
			</action>
		</page>

		<!-- Queue updater ZIP using the standard file-browser install flow -->
		<page name="fox_update_queue_zip">
			<action>
				<action function="queueclear"/>
				<action function="queuezip"/>
				<action function="set">tw_q_1=%tw_file%</action>
				<action function="page">flash_confirm</action>
			</action>
		</page>

		<!-- Route after checking: open variant picker only when needed -->
		<page name="fox_update_after_check">
			<action>
				<condition var1="fox_update_need_variant" var2="1"/>
				<action function="page">fox_update_variants</action>
			</action>

			<action>
				<condition var1="fox_update_need_variant" op="!=" var2="1"/>
				<action function="page">fox_updates</action>
			</action>
		</page>

		<!-- Available update releases -->
		<page name="fox_update_releases">
			<template name="base"/>

			<action>
				<action function="set">wlanlistdisplay=0</action>
				<action function="set">wlansaveddisplay=0</action>
				<action function="set">fox_update_release_selection=/tmp/fox_update/available_list.txt</action>
			</action>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Available Releases</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>%fox_update_available_count% releases found</text>
			</text>

			<listbox style="group_list_flat">
				<placement x="0" y="%row2_2a_y%" w="%screen_w%" h="%bl_h5%"/>
				<iconsize w="55" h="%bl_h1%" padding="0"/>
				<data name="fox_update_release_selection"/>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="set">fox_update_release_selection=</action>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="set">fox_update_release_selection=</action>
				<action function="page">fox_updates</action>
			</action>
		</page>

		<!-- OrangeFox update changelog page -->
		<page name="fox_update_changelog">
			<template name="base"/>

			<action>
				<action function="set">wlanlistdisplay=0</action>
				<action function="set">wlansaveddisplay=0</action>
				<action function="set">of_file_to_read=</action>
				<action function="set">of_file_to_read=/tmp/fox_update/changelog.txt</action>
			</action>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Update Changelog</text>
			</text>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>Changelog</text>
			</text>

			<text style="text_body2_hl">
				<condition var1="fileexists" op="!=" var2="/tmp/fox_update/changelog.txt"/>
				<placement x="%gl_text_x%" y="%row2_2a_y%"/>
				<text>No changelog loaded</text>
			</text>

			<listbox style="group_list_flat">
				<condition var1="fileexists" var2="/tmp/fox_update/changelog.txt"/>
				<placement x="0" y="%row2_2a_y%" w="%screen_w%" h="%bl_h5%"/>
				<iconsize w="55" h="%bl_h1%" padding="0"/>
				<data name="of_file_to_read"/>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="set">of_file_to_read=</action>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="set">of_file_to_read=</action>
				<action function="page">fox_updates</action>
			</action>
		</page>

		<!-- Variant picker page -->
		<page name="fox_update_variants">
			<template name="base"/>

			<action>
				<action function="set">of_file_to_read=/tmp/fox_update/changelog.txt</action>
			</action>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Select Update Variant</text>
			</text>

			<button style="actionbar">
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<action function="page">fox_updates</action>
			</button>

			<image>
				<placement x="%ab_btn1_x%" y="%ab_y%" placement="4"/>
				<image resource="actionbar_back"/>
			</image>

			<text style="caption">
				<placement x="%gl_text_x%" y="%row2_1a_y%"/>
				<text>Multiple variants found</text>
